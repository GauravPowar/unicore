# ============================================================
# ShodhConnect – Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ShodhConnect

# ── Feature Flags ─────────────────────────────────────────────
# Set to "true" to use live Supabase data; "false" uses built-in mock data
NEXT_PUBLIC_USE_MOCK_DATA=true

# ── ORCID (optional) ─────────────────────────────────────────
# If you want to verify ORCID iDs server-side via the ORCID public API:
# ORCID_CLIENT_ID=APP-XXXXXXXXXXXX
# ORCID_CLIENT_SECRET=your-orcid-client-secret

# ── Cloudinary (optional alternative to Supabase Storage) ────
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
